{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rehister-upload-form",
  "compatibility_date": "2026-04-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".gitignore",
      "package.json",
      "README.md",
      "LICENSE",
      "wrangler.jsonc"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}